{
  "name": "tigerbeetle",
  "runtime": "component",
  "exports": {
    "start": {
      "description": "Install a verified prebuilt TigerBeetle release, format a development data file if needed, and start it with FluentCI’s native host service manager.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "description": "Workspace directory used for native lifecycle calls and ownership metadata. Default: ."
          },
          "name": {
            "type": "string",
            "description": "Service name beginning with module-tigerbeetle-. Default module-tigerbeetle-default."
          },
          "version": {
            "type": "string",
            "description": "Official prebuilt TigerBeetle release, or latest. Default 0.17.9. Stop before changing versions."
          },
          "port": {
            "type": "integer",
            "description": "Explicit loopback host port, from 1 to 65535. Default 3000; native host services do not allocate Docker ports."
          },
          "stateDir": {
            "type": "string",
            "minLength": 1,
            "description": "Required absolute caller-owned data directory. Formats a single development replica only when no data file exists; stop preserves data."
          },
          "cacheGrid": {
            "type": "string",
            "description": "Grid cache size such as 256MiB or 1GiB. Default 256MiB for CI."
          },
          "extraArgs": {
            "type": "string",
            "description": "Comma-separated extra native option tokens. Whitespace is trimmed and empty entries rejected; use typed port/cacheGrid instead of overriding those flags."
          },
          "startupTimeoutMs": {
            "type": "integer",
            "description": "Native TCP readiness deadline, from 100 to 600000 milliseconds. Default 60000."
          },
          "stopTimeoutMs": {
            "type": "integer",
            "description": "Native stop deadline, from 100 to 120000 milliseconds. Default 5000."
          }
        },
        "required": [
          "stateDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "name",
          "state",
          "backend",
          "host",
          "port",
          "endpoint",
          "ports"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "containerPort",
                "port",
                "address"
              ],
              "properties": {
                "containerPort": {
                  "type": "integer"
                },
                "port": {
                  "type": "integer"
                },
                "address": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "stop": {
      "description": "Stop only this named service through the native manager; preserve explicitly mounted data. Native dependents are stopped too.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "description": "Workspace directory used by every native service manager call. Default: \".\"."
          },
          "name": {
            "type": "string",
            "description": "Full service name, default module-tigerbeetle-default; must start with module-tigerbeetle- to scope lifecycle operations."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "name",
          "state",
          "backend",
          "host",
          "port",
          "endpoint",
          "ports"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "containerPort",
                "port",
                "address"
              ],
              "properties": {
                "containerPort": {
                  "type": "integer"
                },
                "port": {
                  "type": "integer"
                },
                "address": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "restart": {
      "description": "Restart the existing native service definition and wait for readiness.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "description": "Workspace directory used by every native service manager call. Default: \".\"."
          },
          "name": {
            "type": "string",
            "description": "Full service name, default module-tigerbeetle-default; must start with module-tigerbeetle- to scope lifecycle operations."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "name",
          "state",
          "backend",
          "host",
          "port",
          "endpoint",
          "ports"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "containerPort",
                "port",
                "address"
              ],
              "properties": {
                "containerPort": {
                  "type": "integer"
                },
                "port": {
                  "type": "integer"
                },
                "address": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "status": {
      "description": "Return the service’s native lifecycle state and actual loopback port bindings.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "description": "Workspace directory used by every native service manager call. Default: \".\"."
          },
          "name": {
            "type": "string",
            "description": "Full service name, default module-tigerbeetle-default; must start with module-tigerbeetle- to scope lifecycle operations."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "name",
          "state",
          "backend",
          "host",
          "port",
          "endpoint",
          "ports"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "backend": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "containerPort",
                "port",
                "address"
              ],
              "properties": {
                "containerPort": {
                  "type": "integer"
                },
                "port": {
                  "type": "integer"
                },
                "address": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "logs": {
      "description": "Read native service logs; optionally follow new output until interrupted, without starting or stopping a service.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "description": "Workspace directory used by every native service manager call. Default: \".\"."
          },
          "name": {
            "type": "string",
            "description": "Full service name, default module-tigerbeetle-default; must start with module-tigerbeetle- to scope lifecycle operations."
          },
          "tail": {
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 10000,
            "description": "Maximum recent log lines, from 1 to 10000, before optional live output. Default: 100."
          },
          "follow": {
            "type": "boolean",
            "default": false,
            "description": "Stream new native service logs until interrupted. Default false returns a bounded snapshot. Interrupting logs leaves the background service running. Default: false."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "string"
      }
    }
  }
}
