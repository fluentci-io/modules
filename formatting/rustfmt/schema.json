          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Files selected for the native operation; paths are passed literally without shell expansion."
          }
        },
        "required": [
          "runDir",
          "files"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
