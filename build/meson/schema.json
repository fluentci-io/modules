              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "arguments"
          }
        },
        "required": [
          "runDir",
          "arguments"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
