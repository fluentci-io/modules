        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
