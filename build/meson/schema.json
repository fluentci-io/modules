          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "buildtype": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "plain",
              "debug",
              "debugoptimized",
              "release",
              "minsize",
              "custom"
            ],
            "description": "Buildtype supplied to the meson configure operation. Allowed values: plain, debug, debugoptimized, release, minsize, custom."
          },
          "prefix": {
            "type": "string",
            "minLength": 1,
            "description": "Prefix supplied to the meson configure operation."
          },
          "backend": {
            "type": "string",
            "minLength": 1,
            "description": "Backend supplied to the meson configure operation."
          },
          "reconfigure": {
            "type": "boolean",
            "description": "Reconfigure supplied to the meson configure operation."
          },
          "definitions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Definitions supplied to the meson configure operation."
          },
          "buildDir": {
            "type": "string",
            "minLength": 1,
            "default": "build",
            "description": "Directory containing the configured build tree. Default: \"build\"."
          },
          "sourceDir": {
            "type": "string",
            "minLength": 1,
            "default": ".",
            "description": "Directory containing the source project. Default: \".\"."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
