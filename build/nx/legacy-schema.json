          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
    "run_target": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "description": "Project:target[:configuration] selector."
          },
          "configuration": {
            "type": "string",
            "minLength": 1,
            "description": "Named workspace task configuration, for example production."
          },
          "parallel": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum concurrent task processes."
          },
          "exclude": {
            "type": "string",
            "description": "Comma-separated project names or patterns to exclude."
          },
          "outputStyle": {
            "type": "string",
            "minLength": 1,
            "default": "static",
            "enum": [
              "static",
              "static-failures-only",
              "stream",
              "stream-without-prefixes",
              "summary",
              "dynamic-legacy",
              "dynamic",
              "tui"
            ],
            "description": "Native task log rendering; defaults to stable CI output."
          },
          "skipCache": {
            "type": "boolean",
            "description": "Rerun tasks even when local or remote results are cached."
          },
          "skipRemoteCache": {
            "type": "boolean",
            "description": "Disable remote cache access."
          },
          "bail": {
            "type": "boolean",
            "description": "Stop after the first task failure."
          },
          "skipSync": {
            "type": "boolean",
            "description": "Skip automatic sync generators before task execution."
          },
          "graph": {
            "type": "string",
            "minLength": 1,
            "description": "Write the task graph to a file or stdout instead of executing tasks."
          },
          "arguments": {
            "type": "string",
            "description": "Additional literal command tokens in CSV form; include -- as an entry to forward flags to underlying tasks."
          }
        },
        "required": [
          "runDir",
          "target"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
