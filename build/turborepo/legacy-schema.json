            "type": "string",
            "minLength": 1,
            "description": "Workspace package to retain."
          },
          "docker": {
            "type": "boolean",
            "description": "Separate manifests and source for Docker layer caching."
          },
          "outDir": {
            "type": "string",
            "minLength": 1,
            "description": "Destination for the pruned workspace; need not exist."
          },
          "useGitignore": {
            "type": "boolean",
            "description": "Respect gitignore rules when copying files."
          },
          "arguments": {
            "type": "string",
