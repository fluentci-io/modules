    "name": "aerospike",
    "title": "Aerospike",
    "image": "aerospike/aerospike-server",
    "version": "latest",
    "port": 3000,
    "ports": [
      3000
    ],
    "scheme": "aerospike",
    "command": [
      "--config-file",
      "/etc/aerospike/aerospike.conf"
    ],
    "env": {},
    "probe": "tcp",
    "path": "/",
    "exec": [],
    "timeout": 180000,
    "notes": "Single-node test namespace with 512 MiB memory storage. An explicit primary host port (default 3000) is advertised to clients; --port changes it. The generated config advertises 127.0.0.1 for host-based CI clients.",
    "source": "https://github.com/aerospike/aerospike-server.docker",
    "volumes": [],
    "files": {
      "/etc/aerospike/aerospike.conf": "service {\n  cluster-name fluentci\n}\nlogging {\n  console {\n    context any info\n  }\n}\nnetwork {\n  service {\n    address any\n    port 3000\n    access-address 127.0.0.1\n    access-port {{advertisedPort}}\n  }\n  heartbeat {\n    mode mesh\n    port 3002\n    interval 150\n    timeout 10\n  }\n  fabric {\n    port 3001\n  }\n}\nnamespace test {\n  replication-factor 1\n  default-ttl 0\n  storage-engine memory {\n    data-size 512M\n  }\n}\n"
    }
