            "description": "Depot project ID; otherwise native DEPOT_PROJECT_ID or depot.json is used."
          },
          "buildIds": {
            "type": "string",
            "description": "Comma-separated build IDs; native bulk selection requires allRunning and projectId."
          },
          "allRunning": {
            "type": "boolean",
            "description": "Select all running builds in the explicitly selected project."
          },
          "dryRun": {
            "type": "boolean",
            "description": "Preview cancellation without changing builds."
          },
          "yes": {
            "type": "boolean",
            "description": "Explicitly approve bulk cancellation without prompting."
          },
          "output": {
            "type": "string",
