          "noCache": {
            "type": "boolean",
            "description": "No Cache supplied to the buildkit build operation."
          },
          "progress": {
            "type": "string",
            "minLength": 1,
            "description": "Progress supplied to the buildkit build operation."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
