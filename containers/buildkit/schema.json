          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
