          },
          "envNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Names of host environment variables to forward to Railpack, without embedding their values."
          },
          "configFile": {
            "type": "string",
            "minLength": 1,
            "description": "Railpack project configuration file."
          },
          "buildCmd": {
            "type": "string",
            "minLength": 1,
            "description": "Override the project build command; executed by Railpack inside the build."
          },
          "startCmd": {
            "type": "string",
            "minLength": 1,
            "description": "Container start command to include in the image."
          },
          "previous": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Previously selected package versions as NAME@VERSION entries."
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "default": ".",
            "description": "Project source directory to analyze or build."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Container image name/tag to produce."
          },
          "platform": {
            "type": "string",
            "minLength": 1,
            "description": "Target image platform, for example linux/amd64."
          },
          "progress": {
            "type": "string",
            "minLength": 1,
            "default": "plain",
            "description": "BuildKit progress mode: auto, plain, or tty."
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "description": "Export the final filesystem to a local directory."
          },
          "cacheFrom": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "BuildKit cache import specifications."
          },
          "cacheTo": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "BuildKit cache export specifications."
          },
          "noCache": {
            "type": "boolean",
            "description": "Build without reading cached layers."
          }
        },
        "required": [
          "runDir",
          "name"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
