          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "prepare": {
      "description": "Generate a build plan and metadata, failing when the project cannot be prepared.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation’s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation’s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "envNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Names of host environment variables to forward to Railpack, without embedding their values."
          },
          "configFile": {
            "type": "string",
            "minLength": 1,
            "description": "Railpack project configuration file."
          },
          "buildCmd": {
            "type": "string",
            "minLength": 1,
            "description": "Override the project build command; executed by Railpack inside the build."
          },
          "startCmd": {
            "type": "string",
            "minLength": 1,
            "description": "Container start command to include in the image."
          },
          "previous": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Previously selected package versions as NAME@VERSION entries."
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "default": ".",
            "description": "Project source directory to analyze or build. Default: \".\"."
          },
          "planOut": {
            "type": "string",
            "minLength": 1,
            "default": "railpack-plan.json",
            "description": "Destination for the generated JSON build plan. Default: \"railpack-plan.json\"."
          },
          "infoOut": {
            "type": "string",
            "minLength": 1,
            "default": "railpack-info.json",
            "description": "Destination for structured project/build metadata. Default: \"railpack-info.json\"."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
