  config <- either throw pure (C.decodePolicyTestArgs (Contract.buildxInput (Contract.encodeInput args)))
  plan <- either throw pure (C.policyTest config)
  let runtime = C.runtimePolicyTest config
  void (B.execute runtime plan)
  pure { outcome: "succeeded", runDir: runtime.runDir, reportPath: runtime.runDir <> "/result.json", stdoutPath: runtime.runDir <> "/buildx.stdout", stderrPath: runtime.runDir <> "/buildx.stderr" }

-- | Run Docker Buildx history inspect attachment and return execution report paths.
-- | @param project Working directory containing the source checkout; defaults to the current directory. Default: ".".
-- | @param runDir Fresh directory for this invocation’s execution report and task logs; must not already exist.
-- | @param docker Docker executable name or absolute path. Default: "docker".
-- | @param timeoutMs Maximum task duration in milliseconds; defaults to 900000. Default: 900000.
-- | @param experimental Enable experimental Docker Buildx features. Default: false.
-- | @param references Optional REF and DIGEST positional arguments. Default: [].
-- | @param builder --builder: Override the configured builder instance
-- | @param debug --debug: Enable debug logging
-- | @param format --format: Format the output (default "pretty")
-- | @param platform --platform: Platform of attachment
-- | @param type --type: Type of attachment
history_inspect_attachment :: { project :: Maybe String, runDir :: String, docker :: Maybe String, timeoutMs :: Maybe Int, experimental :: Maybe Boolean, references :: Maybe (Array String), builder :: Maybe String, debug :: Maybe Boolean, format :: Maybe String, platform :: Maybe String, "type" :: Maybe String } -> Effect Contract.ExecutionResult
history_inspect_attachment args = do
  config <- either throw pure (C.decodeHistoryInspectAttachmentArgs (Contract.buildxInput (Contract.encodeInput args)))
  plan <- either throw pure (C.historyInspectAttachment config)
  let runtime = C.runtimeHistoryInspectAttachment config
  void (B.execute runtime plan)
  pure { outcome: "succeeded", runDir: runtime.runDir, reportPath: runtime.runDir <> "/result.json", stdoutPath: runtime.runDir <> "/buildx.stdout", stderrPath: runtime.runDir <> "/buildx.stderr" }
