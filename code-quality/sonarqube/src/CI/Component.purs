-- | @param runDir Fresh directory for this invocation’s execution report and task logs; must not already exist.
-- | @param executable Native CLI executable name or absolute path; defaults to this operation’s tool.
-- | @param timeoutMs Maximum task duration in milliseconds; defaults to 900000. Default: 900000.
-- | @param artifacts Comma-separated NAME=PATH output artifacts; use CSV double quotes around entries containing commas.
allowlist_secrets_add :: { project :: Maybe String, runDir :: String, executable :: Maybe String, timeoutMs :: Maybe Int, artifacts :: Maybe String } -> Effect Contract.ExecutionResult
allowlist_secrets_add args = do
  json <- Native.csvInput (Contract.input (Contract.encodeInput args)) >>= Contract.cliInput
  Native.executeWithSetup Dependencies.ensureFor "sonarqube" "allowlist_secrets_add" json

