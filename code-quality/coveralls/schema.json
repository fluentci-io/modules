{
  "name": "coveralls",
  "exports": {
    "run": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "arguments"
          }
        },
        "required": [
          "runDir",
          "arguments"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
    "version": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
    "upload": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          },
          "format": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "lcov",
              "simplecov",
              "cobertura",
              "jacoco",
              "gcov",
              "luacov",
              "golang",
              "python"
            ],
            "description": "format"
          },
          "basePath": {
            "type": "string",
            "minLength": 1,
            "description": "basePath"
          },
          "jobFlag": {
            "type": "string",
            "minLength": 1,
            "description": "jobFlag"
          },
          "buildNumber": {
            "type": "string",
            "minLength": 1,
            "description": "buildNumber"
          },
          "parallel": {
            "type": "boolean",
            "description": "parallel"
          },
          "dryRun": {
            "type": "boolean",
            "description": "dryRun"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "files"
          }
        },
        "required": [
          "runDir",
          "files"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
    "done": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          },
          "buildNumber": {
            "type": "string",
            "minLength": 1,
            "description": "buildNumber"
          },
          "carryforward": {
            "type": "string",
            "minLength": 1,
            "description": "carryforward"
          },
          "dryRun": {
            "type": "boolean",
            "description": "dryRun"
          }
        },
        "required": [
          "runDir",
          "buildNumber"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    }
  }
}
