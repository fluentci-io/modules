{
  "name": "sonarqube-scanner",
  "exports": {
    "run": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "arguments": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated arguments; values are passed as literal native arguments."
          }
        },
        "required": [
          "runDir",
          "arguments"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
    "version": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
    "scan": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "projectKey": {
            "type": "string",
            "minLength": 1,
            "description": "projectKey"
          },
          "sources": {
            "type": "string",
            "description": "Comma-separated source directories; whitespace is trimmed and the native sonar.sources property receives the normalized list."
          },
          "hostUrl": {
            "type": "string",
            "minLength": 1,
            "description": "hostUrl"
          },
          "organization": {
            "type": "string",
            "minLength": 1,
            "description": "organization"
          },
          "qualityGateWait": {
            "type": "boolean",
            "description": "qualityGateWait"
          },
          "properties": {
            "type": "string",
            "description": "Comma-separated properties; values are passed as literal native arguments."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    }
  }
}
