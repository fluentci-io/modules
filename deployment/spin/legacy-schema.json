          },
          "build": {
            "type": "boolean",
            "description": "Build before pushing."
          },
          "compose": {
            "type": "boolean",
            "description": "Compose component dependencies before pushing."
          },
          "annotations": {
            "type": "string",
            "description": "Comma-separated KEY=VALUE OCI image annotations."
