          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "description": "OCI registry reference including the desired tag."
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Local app manifest/directory or native remote reference where supported; native CLI validates the source."
          },
          "profile": {
            "type": "string",
