          "skipTargetChecks": {
            "type": "boolean",
            "description": "Skip deployment-target compatibility checks."
          },
          "skipGenerateWits": {
            "type": "boolean",
            "description": "Skip generating dependency WIT files."
          },
          "arguments": {
            "type": "string",
            "description": "Additional literal native tokens in CSV form; CSV quotes preserve commas inside a token."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
