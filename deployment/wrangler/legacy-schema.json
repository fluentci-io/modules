            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "config": {
            "type": "string",
            "minLength": 1,
            "description": "Path to the Wrangler configuration file."
          },
          "env": {
            "type": "string",
            "minLength": 1,
            "description": "Named Wrangler environment to deploy."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Cloudflare Worker name overriding project configuration."
          },
          "outdir": {
            "type": "string",
            "minLength": 1,
            "description": "Directory for generated Worker bundle files."
          },
          "minify": {
            "type": "boolean",
            "description": "Minify the generated Worker bundle."
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "description": "Optional Worker entrypoint; omitted values use project configuration."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
