          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "environment": {
            "type": "string",
            "minLength": 1,
            "description": "Garden environment, optionally prefixed with a namespace (for example pr-123.ci)."
          },
          "variables": {
            "type": "string",
            "description": "Comma-separated KEY=VALUE variable overrides. For secrets use native environment-backed Garden configuration."
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "json",
              "yaml"
            ],
            "description": "Native structured result format; read it from the returned stdout path."
          },
          "logLevel": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "error",
              "warn",
              "info",
              "verbose",
              "debug",
              "silly"
            ],
            "description": "Native log verbosity."
          },
          "yes": {
            "type": "boolean",
            "description": "Explicitly approve prompts and protected production commands; omitted never auto-approves."
          },
          "names": {
            "type": "string",
            "description": "Comma-separated action names or native glob selectors; omitted or blank selects all eligible actions."
          },
          "force": {
            "type": "boolean",
            "description": "Rebuild even when an existing build can be reused."
          },
          "withDependants": {
            "type": "boolean",
            "description": "Also rebuild downstream dependants."
          },
          "arguments": {
            "type": "string",
            "description": "Literal extra tokens as a comma-separated string; CSV quotes preserve commas inside tokens."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
