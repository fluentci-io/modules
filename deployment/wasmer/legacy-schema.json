          },
          "arguments": {
            "type": "string",
            "description": "Additional literal native tokens in CSV form; CSV quotes preserve commas inside a token."
          }
        },
        "required": [
          "runDir",
          "file"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
