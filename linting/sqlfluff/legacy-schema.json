          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "config": {
            "type": "string",
            "minLength": 1,
            "description": "SQLFluff configuration file; repository configuration remains available when omitted."
          },
          "dialect": {
            "type": "string",
            "minLength": 1,
            "description": "SQL dialect, such as postgres, ansi, bigquery, or snowflake."
          },
          "templater": {
            "type": "string",
            "minLength": 1,
            "description": "Template engine; requires its Python dependencies in the SQLFluff environment."
          },
          "rules": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated rule codes to enable."
          },
          "excludeRules": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated rule codes to exclude."
          },
          "processes": {
            "type": "integer",
            "description": "Worker count; zero uses all CPUs and negative values reserve CPUs."
          },
          "format": {
            "type": "string",
            "minLength": 1,
            "description": "Report format, for example human, json, github-annotation, or sarif."
          },
          "writeOutput": {
            "type": "string",
            "minLength": 1,
            "description": "Report output file to retain as an artifact."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": [
              "."
            ],
            "description": "SQL files or directories to process."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
