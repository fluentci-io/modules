              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "configPath": {
            "type": "string",
            "minLength": 1,
            "description": "Explicit protolint YAML configuration file."
          },
          "configDirPath": {
            "type": "string",
            "minLength": 1,
            "description": "Directory to search for protolint configuration."
          },
          "reporter": {
            "type": "string",
            "minLength": 1,
            "description": "Diagnostic reporter: plain, json, junit, sarif, sonar, unix, or tsc."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": [
              "."
            ],
            "description": "Protocol Buffer files or directories to lint."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    }
  }
}
