              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "configPath": {
            "type": "string",
            "minLength": 1,
            "description": "Explicit protolint YAML configuration file."
          },
          "configDirPath": {
            "type": "string",
            "minLength": 1,
            "description": "Directory to search for protolint configuration."
          },
          "reporter": {
            "type": "string",
            "minLength": 1,
            "description": "Diagnostic reporter: plain, json, junit, sarif, sonar, unix, or tsc."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": [
              "."
            ],
            "description": "Protocol Buffer files or directories to lint. Default: [\".\"]."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
