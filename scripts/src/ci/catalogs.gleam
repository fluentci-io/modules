import ci/common as c
import ci/data as d
import ci/files as f
import gleam/list
import gleam/result
import gleam/string

fn obj(pairs: List(#(String, d.Value))) -> d.Value {
  d.Object(pairs)
}

fn typ(kind: String) -> d.Value {
  obj([#("type", d.Text(kind))])
}

fn set(value: d.Value, key: String, item: String) -> d.Value {
  d.put(value, key, d.Text(item))
}

pub fn service(root: String, check: Bool) -> Result(Nil, String) {
  use catalog <- result.try(f.json(root <> "/lib/services/catalog.json"))
  f.generated(
    root <> "/lib/services/src/CI/Services/Catalog.purs",
    "-- Generated by Gleam CI helpers.\nmodule CI.Services.Catalog where\n\ndefinitions :: String\ndefinitions = "
      <> d.quote(d.encode(catalog))
      <> "\n",
    check,
  )
}

pub fn cli_schema(command: d.Value) -> d.Value {
  let properties =
    obj([
      #(
        "project",
        obj([
          #("type", d.Text("string")),
          #("default", d.Text(".")),
          #("minLength", d.Number("1")),
        ]),
      ),
      #(
        "runDir",
        obj([#("type", d.Text("string")), #("minLength", d.Number("1"))]),
      ),
      #(
        "executable",
        obj([#("type", d.Text("string")), #("minLength", d.Number("1"))]),
      ),
      #(
        "timeoutMs",
        obj([
          #("type", d.Text("integer")),
          #("minimum", d.Number("1")),
          #("default", d.Number("900000")),
        ]),
      ),
      #(
        "artifacts",
        obj([
          #("type", d.Text("object")),
          #(
            "additionalProperties",
            obj([#("type", d.Text("string")), #("minLength", d.Number("1"))]),
          ),
          #(
            "description",
            d.Text(
              "Named output files to collect with their sizes and SHA-256 digests in the execution report.",
            ),
          ),
        ]),
      ),
    ])
  let #(properties, required) =
    list.fold(
      d.array(d.get(command, "fields")),
      #(properties, [d.Text("runDir")]),
      fn(acc, field) {
        let kind = case d.s(field, "kind") {
          "csv" -> "string"
          other -> other
        }
        let prop = case kind {
          "strings" ->
            obj([
              #("type", d.Text("array")),
              #(
                "items",
                obj([#("type", d.Text("string")), #("minLength", d.Number("1"))]),
              ),
            ])
          _ -> typ(kind)
        }
        let prop = case
          kind == "string"
          && { d.s(field, "kind") != "csv" || d.bool(d.get(field, "required")) }
        {
          True -> d.put(prop, "minLength", d.Number("1"))
          False -> prop
        }
        let prop = case kind == "integer" && d.s(field, "style") != "signed" {
          True ->
            d.put(
              prop,
              "minimum",
              d.Number(case d.s(field, "style") {
                "nonnegative" -> "0"
                _ -> "1"
              }),
            )
          False -> prop
        }
        let prop = case kind == "strings" && d.bool(d.get(field, "required")) {
          True -> d.put(prop, "minItems", d.Number("1"))
          False -> prop
        }
        let prop = case d.get(field, "default") {
          d.Null -> prop
          value -> d.put(prop, "default", value)
        }
        let prop = case d.array(d.get(field, "choices")) {
          [] -> prop
          values -> d.put(prop, "enum", d.Array(values))
        }
        let required = case
          d.get(field, "default") == d.Null && d.bool(d.get(field, "required"))
        {
          True -> list.append(acc.1, [d.get(field, "key")])
          False -> acc.1
        }
        #(
          d.put(
            acc.0,
            d.s(field, "key"),
            set(prop, "description", d.s(field, "description")),
          ),
          required,
        )
      },
    )
  obj([
    #(
      "input",
      obj([
        #("type", d.Text("object")),
        #("properties", properties),
        #("required", d.Array(required)),
        #("additionalProperties", d.Bool(False)),
      ]),
    ),
    #(
      "output",
      obj([
        #("type", d.Text("string")),
        #("contentType", d.Text("application/json")),
      ]),
    ),
  ])
}

fn cli_options(tool: d.Value) -> String {
  let header = [
    "# " <> d.s(tool, "title") <> " module arguments",
    "",
    "Generated from [the CLI catalog](../../lib/cli/catalog.json).",
    "",
    "Every export requires a fresh `runDir`. Common fields are `project` (default `.`),",
    "`executable` (the CLI program or path), `timeoutMs` (default `900000`), and",
    case d.bool(d.get(tool, "csvLists")) {
      True ->
        "`artifacts` is a comma-separated NAME=PATH string in the public component contract."
      False -> "`artifacts` (an object mapping output names to file paths)."
    },
    "",
  ]
  let commands =
    list.flat_map(d.array(d.get(tool, "commands")), fn(command) {
      let fields =
        list.map(d.array(d.get(command, "fields")), fn(field) {
          let flag = d.s(field, "flag")
          let key = d.s(field, "key")
          let style = d.s(field, "style")
          let argument = case style {
            "separate" | "file-separate" | "directory-separate" ->
              flag <> " <value>"
            "comma-list" | "assignment-list" ->
              flag <> "=<comma-separated values>"
            "space-list" -> flag <> " <values...>"
            _ ->
              case string.starts_with(style, "prefix:") {
                True ->
                  {
                    case flag == "" {
                      True -> ""
                      False -> flag <> "="
                    }
                  }
                  <> string.drop_start(style, 7)
                  <> "<value>"
                False ->
                  {
                    case flag == "" {
                      True -> "<" <> key <> ">"
                      False -> flag
                    }
                  }
                  <> case flag != "" && style != "switch" {
                    True -> "=<value>"
                    False -> ""
                  }
              }
          }
          let argument =
            argument
            <> case string.starts_with(d.s(field, "scope"), "before:") {
              True ->
                " (before " <> string.drop_start(d.s(field, "scope"), 7) <> ")"
              False -> ""
            }
          let kind = case d.s(field, "kind") {
            "csv" -> "string (CSV)"
            other -> other
          }
          let kind =
            kind
            <> case d.strings(d.get(field, "choices")) {
              [] -> ""
              values -> " (" <> string.join(values, ", ") <> ")"
            }
          let default = case d.get(field, "default") {
            d.Null ->
              case d.bool(d.get(field, "required")) {
                True -> "Required"
                False -> "Omitted"
              }
            value -> "`" <> d.encode(value) <> "`"
          }
          "| `"
          <> key
          <> "` | `"
          <> kind
          <> "` | `"
          <> argument
          <> "`"
          <> case d.s(field, "scope") == "global" {
            True -> " (global)"
            False -> ""
          }
          <> " | "
          <> default
          <> " |"
        })
      list.append(
        [
          "## `" <> d.s(command, "name") <> "`",
          "",
          d.s(command, "description"),
          "",
          "| Field | Type | CLI argument | Default / required |",
          "| --- | --- | --- | --- |",
        ],
        list.append(fields, [""]),
      )
    })
  f.lines(list.append(header, commands))
}

pub fn cli(root: String, check: Bool) -> Result(Nil, String) {
  use catalog <- result.try(f.json(root <> "/lib/cli/catalog.json"))
  use _ <- result.try(f.generated(
    root <> "/lib/cli/src/CI/CLI/Catalog.purs",
    "-- Generated by Gleam CI helpers.\nmodule CI.CLI.Catalog where\n\ndefinitions :: String\ndefinitions = "
      <> d.quote(d.encode(catalog))
      <> "\n",
    check,
  ))
  c.all(d.array(catalog), fn(tool) {
    let name = d.s(tool, "name")
    let title = f.title(name)
    let directory = root <> "/" <> d.s(tool, "path")
    let exports =
      list.map(d.array(d.get(tool, "commands")), fn(command) {
        d.s(command, "name")
      })
    let module = "CI.Modules." <> title
    let header = [
      "-- Generated by Gleam CI helpers.",
      "module "
        <> module
        <> " ("
        <> string.join(exports, ", ")
        <> ", planFor) where",
      "",
      "import CI.CLI as CLI",
      "import Data.Argonaut.Core (Json)",
      "import Data.Either (Either)",
      "import Effect (Effect)",
      "import FluentCI.Host.Plan as Plan",
      "import Prelude (Unit)",
      "",
      "planFor :: String -> Json -> Either String Plan.Plan",
      "planFor = CLI.makePlan " <> d.quote(name),
      "",
    ]
    let body =
      list.flat_map(exports, fn(command) {
        [
          command <> " :: Effect Unit",
          command
            <> " = CLI.invoke "
            <> d.quote(name)
            <> " "
            <> d.quote(command),
          "",
        ]
      })
    use _ <- result.try(f.generated(
      directory <> "/src/CI/Modules/" <> title <> ".purs",
      f.lines(list.append(header, body)),
      check,
    ))
    use _ <- result.try(f.generated(
      directory <> "/legacy-entry.mjs",
      "export { "
        <> string.join(exports, ", ")
        <> " } from \"./output/"
        <> module
        <> "/index.js\";\n",
      check,
    ))
    let schema =
      obj([
        #("name", d.Text(name)),
        #(
          "exports",
          obj(
            list.map(d.array(d.get(tool, "commands")), fn(command) {
              #(d.s(command, "name"), cli_schema(command))
            }),
          ),
        ),
      ])
    use _ <- result.try(f.generated(
      directory <> "/legacy-schema.json",
      d.pretty(schema),
      check,
    ))
    f.generated(directory <> "/OPTIONS.md", cli_options(tool), check)
  })
}

pub fn setup(root: String, check: Bool) -> Result(Nil, String) {
  use catalog <- result.try(f.json(root <> "/lib/setup/tools.json"))
  let tools = d.array(catalog)
  let names =
    string.join(list.map(tools, fn(t) { d.quote(d.s(t, "name")) }), ", ")
  let defaults =
    string.concat(
      list.filter_map(tools, fn(tool) {
        case d.s(tool, "defaultVersion") {
          "latest" -> Error(Nil)
          value ->
            Ok(
              "  "
              <> d.quote(d.s(tool, "name"))
              <> " -> "
              <> d.quote(value)
              <> "\n",
            )
        }
      }),
    )
  let code =
    "-- Generated by Gleam CI helpers.\nmodule CI.Setup.ToolCatalog where\n\nnames :: Array String\nnames = [ "
    <> names
    <> " ]\n\ndefinitions :: String\ndefinitions = "
    <> d.quote(d.encode(catalog))
    <> "\n\ndefaultVersion :: String -> String\ndefaultVersion = case _ of\n"
    <> defaults
    <> "  _ -> \"latest\"\n"
  use _ <- result.try(f.generated(
    root <> "/lib/setup/src/CI/Setup/ToolCatalog.purs",
    code,
    check,
  ))
  use contracts <- result.try(f.json(
    root <> "/scripts/templates/setup-legacy-contracts.json",
  ))
  c.all(tools, fn(tool) {
    let name = d.s(tool, "name")
    let title = f.title(name)
    let directory = root <> "/setup/" <> name
    let module = "CI.Setup." <> title
    let code = case name {
      "uv" ->
        "-- Generated by Gleam CI helpers.\nmodule CI.Setup.Uv (setup, setupWith, defaultConfig) where\n\nimport Prelude (Unit)\nimport Effect (Effect)\nimport CI.Setup.Types (Result)\nimport CI.Setup.UvEnvironment (Config)\nimport CI.Setup.UvEnvironment as Native\n\ndefaultConfig :: Config\ndefaultConfig = Native.defaultConfig\n\nsetupWith :: Config -> Effect Result\nsetupWith = Native.setupWith\n\nsetup :: Effect Unit\nsetup = Native.setup\n"
      _ ->
        "-- Generated by Gleam CI helpers.\nmodule "
        <> module
        <> " (setup, setupWith, defaultConfig) where\n\nimport Prelude (Unit)\nimport CI.Setup as Setup\nimport CI.Setup.Types (Config, Result, defaults)\nimport Effect (Effect)\n\ndefaultConfig :: Config\ndefaultConfig = defaults "
        <> d.quote(name)
        <> "\n\nsetupWith :: Config -> Effect Result\nsetupWith = Setup.install "
        <> d.quote(name)
        <> "\n\nsetup :: Effect Unit\nsetup = Setup.setup "
        <> d.quote(name)
        <> "\n"
    }
    use _ <- result.try(f.generated(
      directory <> "/src/CI/Setup/" <> title <> ".purs",
      code,
      check,
    ))
    use _ <- result.try(f.generated(
      directory <> "/legacy-entry.mjs",
      "export { setup } from \"./output/" <> module <> "/index.js\";\n",
      check,
    ))
    let spec = case d.get(contracts, name) {
      d.Null -> d.get(contracts, "default")
      value -> value
    }
    let input = d.get(spec, "input")
    let props = d.get(input, "properties")
    let version =
      d.put(d.get(props, "version"), "default", d.get(tool, "defaultVersion"))
    let spec =
      d.put(
        spec,
        "input",
        d.put(input, "properties", d.put(props, "version", version)),
      )
    let schema =
      d.Object([
        #("name", d.Text("setup-" <> name)),
        #("exports", d.Object([#("setup", spec)])),
      ])
    f.generated(directory <> "/legacy-schema.json", d.pretty(schema), check)
  })
}
