{
  "name": "setup-extism",
  "exports": {
    "setup": {
      "input": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "default": "latest"
          },
          "installDir": {
            "type": "string"
          },
          "packageName": {
            "type": "string"
          },
          "sudo": {
            "type": "boolean",
            "default": false
          },
          "cliVersion": {
            "type": "string"
          },
          "jsVersion": {
            "type": "string"
          },
          "pythonVersion": {
            "type": "string"
          },
          "xtpVersion": {
            "type": "string"
          },
          "binaryenVersion": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "binDir": {
            "type": "string"
          },
          "environment": {
            "type": "object"
          }
        }
      }
    }
  }
}
