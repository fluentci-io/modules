{
  "name": "setup-uv",
  "exports": {
    "setup": {
      "input": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "default": "latest"
          },
          "installDir": {
            "type": "string"
          },
          "packageName": {
            "type": "string"
          },
          "sudo": {
            "type": "boolean",
            "default": false
          },
          "pythonVersion": {
            "type": "string",
            "description": "Optional Python version to install or select; omit for uv-only setup."
          },
          "tools": {
            "type": "string",
            "description": "Comma-separated tools to install, optionally with native version constraints such as ruff==0.12.0."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "binDir": {
            "type": "string"
          },
          "environment": {
            "type": "object"
          }
        }
      }
    }
  }
}
