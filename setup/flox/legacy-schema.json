{
  "name": "setup-flox",
  "exports": {
    "setup": {
      "input": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "default": "latest"
          },
          "installDir": {
            "type": "string"
          },
          "packageName": {
            "type": "string"
          },
          "sudo": {
            "type": "boolean",
            "default": false
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Packages to install, optionally with native version selectors."
          },
          "project": {
            "type": "string",
            "default": ".",
            "description": "Project environment directory to initialize or update."
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "binDir": {
            "type": "string"
          },
          "environment": {
            "type": "object"
          }
        }
      }
    }
  }
}
