{
  "name": "setup-wrangler",
  "runtime": "component",
  "exports": {
    "setup": {
      "description": "Install and verify wrangler, select its version, and publish its environment for subsequent tasks.",
      "input": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "Tool release or supported channel to install; omitted values use the documented default."
          },
          "installDir": {
            "type": "string",
            "description": "Absolute per-user installation prefix; omit for native package installations."
          },
          "packageName": {
            "type": "string",
            "description": "Native package or port selector overriding the default repository package name."
          },
          "sudo": {
            "type": "boolean",
            "description": "Use noninteractive sudo for native package or system installation; defaults to false."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "tool",
          "version",
          "binDir",
          "environment"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "binDir": {
            "type": "string"
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "value"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
