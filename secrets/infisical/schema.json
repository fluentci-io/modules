{
  "name": "infisical",
  "runtime": "component",
  "exports": {
    "run": {
      "description": "Execute arbitrary literal CLI arguments.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Literal native CLI argument tokens, passed without shell expansion."
          }
        },
        "required": [
          "runDir",
          "arguments"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "version": {
      "description": "Print the CLI version.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "run_command": {
      "description": "Run a child process with secrets injected into its environment.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "secretProject": {
            "type": "string",
            "minLength": 1,
            "description": "Secret Project supplied to the infisical run_command operation."
          },
          "env": {
            "type": "string",
            "minLength": 1,
            "description": "Env supplied to the infisical run_command operation."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Paths supplied to the infisical run_command operation."
          },
          "recursive": {
            "type": "boolean",
            "description": "Recursive supplied to the infisical run_command operation."
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Executable and literal arguments; secrets are injected into this child process."
          }
        },
        "required": [
          "runDir",
          "command"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
