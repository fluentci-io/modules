{
  "name": "syft",
  "runtime": "component",
  "exports": {
    "run": {
      "description": "Execute arbitrary literal CLI arguments.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Literal native CLI argument tokens, passed without shell expansion."
          }
        },
        "required": [
          "runDir",
          "arguments"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "version": {
      "description": "Print the CLI version.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scan": {
      "description": "Generate an SBOM for a directory, image, or archive.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "output": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": [
              "syft-json"
            ],
            "description": "Destination path for generated packages. Default: [\"syft-json\"]."
          },
          "config": {
            "type": "string",
            "minLength": 1,
            "description": "Named configuration selected by the native tool."
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Exclude supplied to the syft scan operation."
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Source supplied to the syft scan operation."
          }
        },
        "required": [
          "runDir",
          "source"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "convert": {
      "description": "Convert an existing SBOM to a supported output format.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "output": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "default": [
              "cyclonedx-json"
            ],
            "description": "Destination path for generated packages. Default: [\"cyclonedx-json\"]."
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "File supplied to the syft convert operation."
          }
        },
        "required": [
          "runDir",
          "file"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
