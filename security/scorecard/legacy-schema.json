          },
          "report": {
            "type": "string",
            "minLength": 1,
            "description": "Scorecard JSON report path."
          },
          "minimum": {
            "type": "integer",
            "minimum": 1,
            "default": 7,
            "description": "Minimum score for every reported check (1–10)."
          }
        },
        "required": [
