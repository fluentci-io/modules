          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "description": "repo"
          }
        },
        "required": [
          "runDir",
          "repo"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
