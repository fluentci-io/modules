{
  "name": "grype",
  "runtime": "component",
  "exports": {
    "run": {
      "description": "Execute arbitrary literal CLI arguments.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation’s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation’s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Literal native CLI argument tokens, passed without shell expansion."
          }
        },
        "required": [
          "runDir",
          "arguments"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "version": {
      "description": "Print the CLI version.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation’s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation’s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scan": {
      "description": "Scan an image, directory, or SBOM and fail on the configured severity threshold.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation’s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation’s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "failOn": {
            "type": "string",
            "minLength": 1,
            "default": "high",
            "enum": [
              "negligible",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "description": "Fail On supplied to the grype scan operation. Default: \"high\". Allowed values: negligible, low, medium, high, critical."
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "default": "json",
            "description": "Destination path for generated packages. Default: \"json\"."
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "description": "File supplied to the grype scan operation."
          },
          "config": {
            "type": "string",
            "minLength": 1,
            "description": "Named configuration selected by the native tool."
          },
          "onlyFixed": {
            "type": "boolean",
            "description": "Only Fixed supplied to the grype scan operation."
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "description": "Source supplied to the grype scan operation."
          }
        },
        "required": [
          "runDir",
          "source"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "db_update": {
      "description": "Download the current vulnerability database.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation’s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation’s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
