            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "Key file, env:// reference, or supported KMS URI; credentials are inherited."
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "description": "OCI image reference, preferably pinned by digest."
          }
        },
        "required": [
          "runDir",
