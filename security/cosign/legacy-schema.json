          },
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "Key file, env:// reference, or supported KMS URI; credentials are inherited."
          },
          "image": {
            "type": "string",
            "minLength": 1,
            "description": "OCI image reference, preferably pinned by digest."
          }
        },
        "required": [
          "runDir",
          "image"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
