{
  "name": "checkov",
  "runtime": "component",
  "exports": {
    "run": {
      "description": "Execute arbitrary literal CLI arguments.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Literal native CLI argument tokens, passed without shell expansion."
          }
        },
        "required": [
          "runDir",
          "arguments"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "version": {
      "description": "Print the CLI version.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "scan": {
      "description": "Scan infrastructure code, failing when policy checks fail.",
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1,
            "description": "Working directory containing the source checkout; defaults to the current directory. Default: \".\"."
          },
          "runDir": {
            "type": "string",
            "minLength": 1,
            "description": "Fresh directory for this invocation\u2019s execution report and task logs; must not already exist."
          },
          "executable": {
            "type": "string",
            "minLength": 1,
            "description": "Native CLI executable name or absolute path; defaults to this operation\u2019s tool."
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000,
            "description": "Maximum task duration in milliseconds; defaults to 900000. Default: 900000."
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output artifacts to collect as NAME=PATH entries; names must be unique."
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "default": ".",
            "description": "Input directory containing the package tree to validate and build. Default: \".\"."
          },
          "framework": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Framework supplied to the checkov scan operation."
          },
          "configFile": {
            "type": "string",
            "minLength": 1,
            "description": "Config File supplied to the checkov scan operation."
          },
          "check": {
            "type": "string",
            "minLength": 1,
            "description": "Check supplied to the checkov scan operation."
          },
          "skipCheck": {
            "type": "string",
            "minLength": 1,
            "description": "Skip Check supplied to the checkov scan operation."
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "default": "json",
            "description": "Destination path for generated packages. Default: \"json\"."
          },
          "outputFilePath": {
            "type": "string",
            "minLength": 1,
            "description": "Output File Path supplied to the checkov scan operation."
          }
        },
        "required": [
          "runDir"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
            "type": "string"
          },
          "reportPath": {
            "type": "string"
          },
          "stdoutPath": {
            "type": "string"
          },
          "stderrPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
