          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "description": "Job Id supplied to the gitlab-artifacts upload operation."
          },
          "apiUrl": {
            "type": "string",
            "minLength": 1,
            "default": "https://gitlab.com/api/v4",
            "description": "Api Url supplied to the gitlab-artifacts upload operation. Default: \"https://gitlab.com/api/v4\"."
          }
        },
        "required": [
          "runDir",
          "archive",
          "jobId"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "required": [
          "outcome",
          "runDir",
          "reportPath",
          "stdoutPath",
          "stderrPath"
        ],
        "properties": {
          "outcome": {
            "type": "string"
          },
          "runDir": {
