          },
          "repo": {
            "type": "string",
            "minLength": 1,
            "description": "Repo supplied to the gitlab-artifacts download operation."
          },
          "job": {
            "type": "string",
            "minLength": 1,
            "description": "Job supplied to the gitlab-artifacts download operation."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "default": "dist",
            "description": "Path supplied to the gitlab-artifacts download operation. Default: \"dist\"."
          },
          "ref": {
            "type": "string",
            "minLength": 1,
