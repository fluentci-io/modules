            "type": "string",
            "minLength": 1,
            "description": "Repository URL or local source path."
          },
          "directory": {
            "type": "string",
            "minLength": 1,
            "description": "Destination checkout directory; native Git chooses the default when omitted."
          },
          "extraArgs": {
            "type": "string",
            "description": "Comma-separated additional literal native tokens; no shell expansion. Empty entries are rejected; CSV quotes preserve literal commas."
          }
        },
        "required": [
          "runDir",
          "url"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
