    "run": {
      "input": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string",
            "default": ".",
            "minLength": 1
          },
          "runDir": {
            "type": "string",
            "minLength": 1
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "default": 900000
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "description": "Named output files to collect with their sizes and SHA-256 digests in the execution report."
          },
          "arguments": {
            "type": "string",
            "minLength": 1,
            "description": "Required comma-separated gh command and literal argument tokens; never JSON."
          }
        },
        "required": [
          "runDir",
          "arguments"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "string",
        "contentType": "application/json"
      }
    },
